colors = [&quot;Red&quot;, &quot;Green&quot;, &quot;Blue&quot;]

graph = {
&quot;A&quot;: [&quot;B&quot;, &quot;C&quot;],
&quot;B&quot;: [&quot;A&quot;, &quot;C&quot;, &quot;D&quot;],
&quot;C&quot;: [&quot;A&quot;, &quot;B&quot;, &quot;D&quot;],
&quot;D&quot;: [&quot;B&quot;, &quot;C&quot;]
}

result = {}

def solve(region):
if region == len(graph):
return True

node = list(graph.keys())[region]

for color in colors:
valid = True

for neighbor in graph[node]:
if result.get(neighbor) == color:
valid = False
break

if valid:
result[node] = color

if solve(region + 1):
return True

del result[node]

return False

solve(0)

print(&quot;Color Assignment:&quot;)
for region in result:

print(region, &quot;=&quot;, result[region])
