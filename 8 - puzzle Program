import heapq

goal = [[1,2,3],
        [4,5,6],
        [7,8,0]]

moves = [(-1,0),(1,0),(0,-1),(0,1)]

def heuristic(state):
    count = 0
    for i in range(3):
        for j in range(3):
            if state[i][j] != 0 and state[i][j] != goal[i][j]:
                count += 1
    return count

def find_zero(state):
    for i in range(3):
        for j in range(3):
            if state[i][j] == 0:
                return i, j

def to_tuple(state):
    return tuple(tuple(row) for row in state)

def astar(start):
    pq = []
    heapq.heappush(pq, (heuristic(start), 0, start))
    visited = set()

    while pq:
        f, g, state = heapq.heappop(pq)

        if state == goal:
            print("Goal State Reached:")
            for row in state:
                print(row)
            return

        visited.add(to_tuple(state))

        x, y = find_zero(state)

        for dx, dy in moves:
            nx, ny = x + dx, y + dy

            if 0 <= nx < 3 and 0 <= ny < 3:
                new_state = [row[:] for row in state]
                new_state[x][y], new_state[nx][ny] = new_state[nx][ny], new_state[x][y]

                if to_tuple(new_state) not in visited:
                    h = heuristic(new_state)
                    heapq.heappush(pq, (g+h+1, g+1, new_state))

start = [[1,2,3],
         [4,0,6],
         [7,5,8]]

astar(start)
